# Supabase
# Get these from: supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps Platform
# Get these from: console.cloud.google.com → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Geocoding API, Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-client-maps-key
GOOGLE_MAPS_API_KEY=your-server-maps-key

# Resend (email)
# Get this from: resend.com → API Keys
RESEND_API_KEY=re_your-resend-key

# Cron secret — any random string, used to secure /api/cron/* endpoints
# Generate one at: https://generate-secret.vercel.app/32
CRON_SECRET=your-random-cron-secret

# Supabase auth email hook
# Bearer token for the Supabase "Send Email" auth hook — must match the value
# set in Supabase Dashboard → Authentication → Hooks → Send Email. Required in
# both .env.local and Vercel; see CLAUDE.md's "Auth hook deployment note" for
# the exact format (Supabase gives you a `v1,whsec_<base64>` string — store
# that whole string here).
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_your-webhook-signing-secret
